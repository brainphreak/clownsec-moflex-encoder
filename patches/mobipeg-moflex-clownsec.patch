+/****************************************************************************
+ * x264_getenv_cached: see base.h
+ ****************************************************************************/
+#undef getenv
+#define GETENV_SLOTS 512
+static struct { const char *key; char *val; int ready; } getenv_slot[GETENV_SLOTS];
+char *x264_getenv_cached( const char *name )
+{
+    uintptr_t h = ((uintptr_t)name >> 3) * 2654435761u;
+    for( int n = 0; n < GETENV_SLOTS; n++ )
+    {
+        int i = (int)((h + n) % GETENV_SLOTS);
+        const char *k = __atomic_load_n( &getenv_slot[i].key, __ATOMIC_ACQUIRE );
+        if( k == name )
+            return __atomic_load_n( &getenv_slot[i].ready, __ATOMIC_ACQUIRE ) ? getenv_slot[i].val : getenv( name );
+        if( !k )
+        {
+            const char *expect = NULL;
+            if( __atomic_compare_exchange_n( &getenv_slot[i].key, &expect, name, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ) )
+            {
+                getenv_slot[i].val = getenv( name );
+                __atomic_store_n( &getenv_slot[i].ready, 1, __ATOMIC_RELEASE );
+                return getenv_slot[i].val;
+            }
+            if( expect == name )
+                return getenv( name );
+        }
+    }
+    return getenv( name );   /* table full: uncached */
+}
