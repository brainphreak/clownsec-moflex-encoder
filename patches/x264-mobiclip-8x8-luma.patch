+/* Mobiclip 8x8 LUMA intra prediction — a faithful size-8 port of
+ * mobi_predict_4x4, matching the decoder's predict_intra(size=8) /
+ * intra_predict_fill for all directional modes (0,1,3,4-8).  Plane (mode 2) is
+ * handled at 16x16 MB granularity by the caller, exactly like the decoder's
+ * decode_macroblock, so it is not needed here.  ax/ay are the 8x8 block's frame
+ * coordinates; p_dst is the block's top-left in the fdec tile. */
+static ALWAYS_INLINE int mobi_pget8( x264_t *h, pixel *p_dst, int ax, int ay, int rx, int ry )
+{
+    const int size = 8;
+    if( rx == -1 && ry >= size )      { rx = -1; ry = size - 1; }
+    else if( rx >= -1 && ry >= -1 )   { /* keep */ }
+    else if( rx == -1 && ry == -2 )   { rx = 0; ry = -1; }
+    else if( rx == -2 && ry == -1 )   { rx = -1; ry = 0; }
+    int mb_x = h->mb.i_mb_x;
+    int mb_y = h->mb.i_mb_y;
+    int orig_x = ax + rx;
+    int orig_y = ay + ry;
+    int tx = orig_x; if( tx < 0 ) tx = 0; else if( tx > h->param.i_width - 1 ) tx = h->param.i_width - 1;
+    int ty = orig_y; if( ty < 0 ) ty = 0; else if( ty > h->param.i_height - 1 ) ty = h->param.i_height - 1;
+    int t_mb_x = tx / 16;
+    int t_mb_y = ty / 16;
+    if( t_mb_y < mb_y || (t_mb_y == mb_y && t_mb_x < mb_x) )
+        return h->fdec->plane[0][ ty * h->mb.pic.i_stride[0] + tx ];
+    else if( t_mb_y == mb_y && t_mb_x == mb_x )
+        return p_dst[ (ty - ay) * FDEC_STRIDE + (tx - ax) ];
+    else
+        return 128;
+}
+static void mobi_predict_8x8( x264_t *h, pixel *p_dst, int ax, int ay, int pmode )
+{
+    const int size = 8;
+    #define MPG8(rx,ry) mobi_pget8(h,p_dst,ax,ay,(rx),(ry))
+    #define HH8(xx,yy)  mobi_half3( MPG8((xx)-1,(yy)), MPG8((xx),(yy)), MPG8((xx)+1,(yy)) )
+    #define HV8(xx,yy)  mobi_half3( MPG8((xx),(yy)-1), MPG8((xx),(yy)), MPG8((xx),(yy)+1) )
+    if( pmode == 3 ) /* DC */
+    {
+        int fill;
+        if( ax == 0 && ay == 0 )
+            fill = 0x80;
+        else if( ax >= 1 && ay >= 1 )
+        {
+            int left = 0, top = 0;
+            for( int y = 0; y < size; y++ ) left += MPG8(-1, y);
+            for( int x = 0; x < size; x++ ) top  += MPG8(x, -1);
+            fill = ((left + top) * 2 / (2*size) + 1) / 2;
+        }
+        else if( ax >= 1 )
+        {
+            int left = 0;
+            for( int y = 0; y < size; y++ ) left += MPG8(-1, y);
+            fill = (left * 2 / size + 1) / 2;
+        }
+        else
+        {
+            int top = 0;
+            for( int x = 0; x < size; x++ ) top += MPG8(x, -1);
+            fill = (top * 2 / size + 1) / 2;
+        }
+        for( int y = 0; y < size; y++ )
+            for( int x = 0; x < size; x++ )
